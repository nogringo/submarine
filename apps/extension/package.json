{
  "name": "submarine-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "core": "dart compile js -O2 -o public/core.js core/web/core.dart && rm -f public/core.js.deps",
    "dev": "pnpm core && wxt",
    "dev:firefox": "pnpm core && wxt -b firefox",
    "build": "pnpm core && wxt build",
    "build:firefox": "pnpm core && wxt build -b firefox",
    "check": "biome check . && tsc --noEmit && tsc --noEmit -p e2e",
    "format": "biome check --write .",
    "test": "vitest run --project unit",
    "test:e2e": "pnpm core && wxt build --mode e2e && wxt build -b firefox --mode e2e && vitest run --project e2e",
    "e2e:browsers": "puppeteer browsers install chrome && puppeteer browsers install firefox",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource/saira-stencil-one": "5.3.0",
    "@noble/curves": "2.0.1",
    "@noble/hashes": "2.0.1",
    "nostr-tools": "2.25.2",
    "react": "19.3.0",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "puppeteer": "25.13.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "wxt": "0.21.4"
  }
}
