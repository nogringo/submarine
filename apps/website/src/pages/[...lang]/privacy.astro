---
import { getEntry, render } from "astro:content";
import { localePaths, message } from "../../i18n";
import Page from "../../layouts/Page.astro";

export const getStaticPaths = localePaths;

const { locale } = Astro.props;
const policy = await getEntry("privacy", locale);
if (!policy) throw new Error(`No privacy policy in ${locale}`);
const { Content, headings } = await render(policy);
const heading = headings.find(({ depth }) => depth === 1);
if (!heading) throw new Error(`No title in the ${locale} privacy policy`);
---

<Page
  locale={locale}
  page="privacy"
  title={heading.text}
  description={message(locale, "privacyDescription")}
>
  <article class="container">
    <Content />
  </article>
</Page>

<style>
  article {
    max-width: 46rem;
  }

  article :global(h1) {
    margin: 0 0 1rem;
    font-size: clamp(1.75rem, 5vw, 2.5rem);
  }

  article :global(h2) {
    margin: 2.5rem 0 0.75rem;
    font-size: 1.5rem;
  }

  article :global(li + li) {
    margin-top: 0.5rem;
  }
</style>
