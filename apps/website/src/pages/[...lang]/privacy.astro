---
import { getEntry } from "astro:content";
import { localePaths, message } from "../../i18n";
import Article from "../../layouts/Article.astro";

export const getStaticPaths = localePaths;

const { locale } = Astro.props;
const policy = await getEntry("privacy", locale);
if (!policy) throw new Error(`No privacy policy in ${locale}`);
---

<Article
  locale={locale}
  page="privacy"
  entry={policy}
  description={message(locale, "privacyDescription")}
/>
