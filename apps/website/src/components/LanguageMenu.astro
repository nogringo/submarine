---
import { languageName, locales, message, type Page, pathOf } from "../i18n";

interface Props {
  locale: string;
  page: Page;
}

const { locale, page } = Astro.props;
---

<details class="language-menu">
  <summary>
    <svg viewBox="0 -960 960 960" aria-hidden="true" focusable="false">
      <path
        d="M480-80q-82 0-155-31.5t-127.5-86Q143-252 111.5-325T80-480q0-83 31.5-155.5t86-127Q252-817 325-848.5T480-880q83 0 155.5 31.5t127 86q54.5 54.5 86 127T880-480q0 82-31.5 155t-86 127.5q-54.5 54.5-127 86T480-80Zm0-82q26-36 45-75t31-83H404q12 44 31 83t45 75Zm-104-16q-18-33-31.5-68.5T322-320H204q29 50 72.5 87t99.5 55Zm208 0q56-18 99.5-55t72.5-87H638q-9 38-22.5 73.5T584-178ZM170-400h136q-3-20-4.5-39.5T300-480q0-21 1.5-40.5T306-560H170q-5 20-7.5 39.5T160-480q0 21 2.5 40.5T170-400Zm216 0h188q3-20 4.5-39.5T580-480q0-21-1.5-40.5T574-560H386q-3 20-4.5 39.5T380-480q0 21 1.5 40.5T386-400Zm268 0h136q5-20 7.5-39.5T800-480q0-21-2.5-40.5T790-560H654q3 20 4.5 39.5T660-480q0 21-1.5 40.5T654-400Zm-16-240h118q-29-50-72.5-87T584-782q18 33 31.5 68.5T638-640Zm-234 0h152q-12-44-31-83t-45-75q-26 36-45 75t-31 83Zm-200 0h118q9-38 22.5-73.5T376-782q-56 18-99.5 55T204-640Z"
      ></path>
    </svg>
    <span class="visually-hidden">{message(locale, "language")}:</span>
    {languageName(locale)}
  </summary>
  <ul>
    {
      locales.map((other) => (
        <li>
          <a
            href={pathOf(other, page)}
            hreflang={other}
            lang={other}
            aria-current={other === locale ? "page" : undefined}
            data-language-choice
          >
            {languageName(other)}
          </a>
        </li>
      ))
    }
  </ul>
</details>

<script>
  import { rememberLanguageChoice } from "../language-choice";

  for (const menu of document.querySelectorAll<HTMLDetailsElement>(".language-menu")) {
    menu.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || !menu.open) return;
      menu.open = false;
      menu.querySelector("summary")?.focus();
    });
    document.addEventListener("click", (event) => {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
    });
    for (const link of menu.querySelectorAll("[data-language-choice]")) {
      link.addEventListener("click", rememberLanguageChoice);
    }
  }
</script>

<style>
  .language-menu {
    position: relative;
  }

  summary {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    padding-inline: 0.75rem;
    border: 2px solid var(--outline);
    border-radius: 999px;
    cursor: pointer;
    font-weight: 600;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: "";
    width: 0.5em;
    height: 0.5em;
    margin-inline-start: 0.2rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: translateY(-0.15em) rotate(45deg);
  }

  [open] > summary::after {
    transform: translateY(0.15em) rotate(-135deg);
  }

  summary svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: currentColor;
  }

  ul {
    position: absolute;
    inset-inline-end: 0;
    z-index: 1;
    min-width: 14rem;
    margin: 0.5rem 0 0;
    padding: 0.4rem;
    border: 1px solid var(--outline);
    border-radius: 0.75rem;
    background: var(--raised);
    list-style: none;
    box-shadow: 0 0.5rem 1.5rem rgb(0 0 0 / 0.2);
  }

  /* In the flow when narrow, where the menu may sit at the left edge. */
  @media (max-width: 40rem) {
    ul {
      position: static;
    }
  }

  a {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.75rem;
    border-radius: 0.5rem;
    color: var(--text);
    text-decoration: none;
  }

  a:hover {
    background: var(--surface);
    text-decoration: underline;
  }

  /* As the app's SelectableRow: the selected fill alone is under 3:1, the pill carries it. */
  a[aria-current] {
    background: var(--selected);
    font-weight: 700;
  }

  a[aria-current]::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    width: 3px;
    height: 1.125rem;
    border-radius: 0 3px 3px 0;
    background: var(--text);
    transform: translateY(-50%);
  }

  @media (forced-colors: active) {
    a[aria-current] {
      outline: 2px solid LinkText;
    }

    a[aria-current]::before {
      background: CanvasText;
    }
  }
</style>
