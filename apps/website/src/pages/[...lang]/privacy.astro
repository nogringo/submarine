---
import type { MarkdownInstance } from "astro";
import { localePaths, message } from "../../i18n";
import Page from "../../layouts/Page.astro";

export const getStaticPaths = localePaths;

const { locale } = Astro.props;

/** English is the extension's own policy, the source of every translation. Named as the ARB files. */
const policies: Record<string, MarkdownInstance<Record<string, unknown>>> = {
  ...import.meta.glob("../../privacy/*.md", { eager: true }),
  "../../privacy/en.md": await import("../../../../extension/PRIVACY.md"),
};
const policy = policies[`../../privacy/${locale.replace("-", "_")}.md`];
if (!policy) throw new Error(`No privacy policy in ${locale}`);
---

<Page
  locale={locale}
  page="privacy"
  title={message(locale, "privacyTitle")}
  description={message(locale, "privacyDescription")}
>
  <article class="container">
    <policy.Content />
  </article>
</Page>

<style>
  article {
    max-width: 46rem;
  }

  article :global(h1) {
    margin: 0 0 1rem;
    font-size: clamp(1.75rem, 5vw, 2.5rem);
  }

  article :global(h2) {
    margin: 2.5rem 0 0.75rem;
    font-size: 1.5rem;
  }

  article :global(li + li) {
    margin-top: 0.5rem;
  }
</style>
