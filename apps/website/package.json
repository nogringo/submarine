{
  "name": "submarine-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "biome check . && astro check",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:a11y": "astro build && node a11y/check.ts",
    "a11y:browser": "puppeteer browsers install chrome"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.3",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource/saira-stencil-one": "5.3.0",
    "astro": "7.3.8",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "axe-core": "4.14.0",
    "puppeteer": "25.13.0",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  }
}
