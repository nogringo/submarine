---
import { type CollectionEntry, render } from "astro:content";
import type { Page as PageName } from "../i18n";
import Page from "./Page.astro";

/** A page written in markdown: its first heading is its title. */
interface Props {
  locale: string;
  page: PageName;
  entry: CollectionEntry<"privacy" | "articles">;
  description: string;
}

const { locale, page, entry, description } = Astro.props;
const { Content, headings } = await render(entry);
const heading = headings.find(({ depth }) => depth === 1);
if (!heading) throw new Error(`No title in ${entry.collection} ${entry.id}`);
---

<Page locale={locale} page={page} title={heading.text} description={description}>
  <article class="container">
    <Content />
  </article>
</Page>

<style>
  article {
    max-width: 46rem;
  }

  article :global(h1) {
    margin: 0 0 1rem;
    font-size: clamp(1.75rem, 5vw, 2.5rem);
  }

  article :global(h2) {
    margin: 2.5rem 0 0.75rem;
    font-size: 1.5rem;
  }

  article :global(h3) {
    margin: 1.75rem 0 0.5rem;
    font-size: 1.2rem;
  }

  article :global(li + li) {
    margin-top: 0.5rem;
  }

  article :global(code) {
    padding: 0.05em 0.35em;
    border: 1px solid var(--line);
    border-radius: 0.3em;
    background: var(--raised);
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 0.9em;
    box-decoration-break: clone;
  }

  article :global(pre) {
    padding: 0.75rem 0.875rem;
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    background: var(--raised);
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    /* Fits the longest line at 320px, so the block never scrolls. */
    font-size: min(0.8em, 3.8vw);
    line-height: 1.5;
    overflow-x: auto;
  }

  article :global(pre code) {
    padding: 0;
    border: 0;
    background: none;
    font-size: inherit;
  }
</style>
