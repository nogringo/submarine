<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and higher: a restored or transferred secure storage cannot be decrypted. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
