{
  "name": "submarine-video",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "footage": "cd ../app && flutter test tool/video_test.dart",
    "soundtrack": "node soundtrack.ts",
    "studio": "remotion studio",
    "render": "remotion render Submarine out/submarine.mp4 && remotion still Thumbnail out/thumbnail.png --scale=1",
    "youtube": "node youtube.ts",
    "check": "biome check . && tsc --noEmit",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-mono": "5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource/saira-stencil-one": "5.3.0",
    "@remotion/cli": "4.0.539",
    "@remotion/fonts": "4.0.539",
    "@remotion/media": "4.0.539",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "typescript": "7.0.2"
  }
}
